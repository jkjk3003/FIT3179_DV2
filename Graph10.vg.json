{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "title": "Volatility of Monthly House Approvals by State (1983-2026)",
  "data": {
    "url": "cleaned_abs_houses.csv"
  },
  "params": [
    {
      "name": "Start_Year",
      "value": 1983,
      "bind": {
        "input": "range",
        "min": 1983,
        "max": 2026,
        "step": 1,
        "name": "Show data from Year: "
      }
    },
    {
      "name": "State_Selection",
      "bind": {
        "input": "select",
        "options": [
          null, 
          "New South Wales", "Victoria", "Queensland", "Western Australia", 
          "South Australia", "Tasmania", "Australian Capital Territory", "Northern Territory"
        ],
        "labels": [
          "Show All", 
          "New South Wales", "Victoria", "Queensland", "Western Australia", 
          "South Australia", "Tasmania", "ACT", "Northern Territory"
        ],
        "name": "Filter by State: "
      }
    }
  ],
"transform": [
    {
      "filter": "State_Selection == null || datum.State == State_Selection"
    },
    {
      "filter": "year(datum.Date) >= Start_Year"
    },
    {
      "calculate": "random()",
      "as": "jitter"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 30,
    "opacity": 0.4,
    "stroke": "black",
    "strokeWidth": 0.2
  },
  "encoding": {
    "x": {
      "field": "Count",
      "type": "quantitative",
      "title": "Monthly House Approvals",
      "axis": {"grid": true}
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": {"op": "median", "field": "Count", "order": "descending"}
    },
    "yOffset": {
      "field": "jitter",
      "type": "quantitative"
    },
    "color": {
      "field": "State",
      "type": "nominal",
      "legend": null,
      "scale": {"scheme": "category10"}
    },
    "tooltip": [
      {"field": "State", "type": "nominal", "title": "State"},
      {"field": "Date", "type": "temporal", "format": "%b %Y", "title": "Month"},
      {"field": "Count", "type": "quantitative", "title": "Houses Approved", "format": ","}
    ]
  }
}