{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 600,
  "title": "Total Protected Footprint of Historic Sites by State",
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0]
  },
  "layer": [
    {
      "data": {
        "url": "australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "National_Heritage_List_Spatial_Database_(NHL)_-_public.csv"
      },
      "transform": [
        {
          "filter": "datum.CLASS == 'Historic' && datum.STATUS == 'Listed place'"
        },
        {
          "aggregate": [{"op": "sum", "field": "AREA_HA", "as": "Total_Area"}],
          "groupby": ["STATE"]
        },
        {
          "lookup": "STATE",
          "from": {
            "data": {
              "values": [
                {"STATE": "NSW", "lon": 146.9, "lat": -31.2, "State_Name": "New South Wales"},
                {"STATE": "VIC", "lon": 144.9, "lat": -36.7, "State_Name": "Victoria"},
                {"STATE": "QLD", "lon": 143.0, "lat": -22.5, "State_Name": "Queensland"},
                {"STATE": "SA",  "lon": 136.2, "lat": -30.0, "State_Name": "South Australia"},
                {"STATE": "WA",  "lon": 122.9, "lat": -27.6, "State_Name": "Western Australia"},
                {"STATE": "TAS", "lon": 146.3, "lat": -42.0, "State_Name": "Tasmania"},
                {"STATE": "NT",  "lon": 133.8, "lat": -19.5, "State_Name": "Northern Territory"},
                {"STATE": "ACT", "lon": 149.0, "lat": -35.3, "State_Name": "Australian Capital Territory"}
              ]
            },
            "key": "STATE",
            "fields": ["lon", "lat", "State_Name"]
          }
        },
        {
          "filter": "datum.lon != null && datum.lat != null"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#8b0000",
        "opacity": 0.6,
        "stroke": "black",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "Total_Area",
          "type": "quantitative",
          "title": "Protected Area (Hectares)",
          "scale": {"range": [100, 3000]}
        },
        "tooltip": [
          {"field": "State_Name", "type": "nominal", "title": "State"},
          {"field": "Total_Area", "type": "quantitative", "title": "Total Area (HA)", "format": ",.0f"}
        ]
      }
    }
  ]
}