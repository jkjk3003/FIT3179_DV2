{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "height": 300,
  "data": {"url": "wikidata_heritage_styles.csv"},
  "transform": [
    {
      "calculate": "indexof(datum.styleLabel, 'Gothic') >= 0 ? 'Gothic' : indexof(datum.styleLabel, 'Art Deco') >= 0 ? 'Art Deco' : indexof(datum.styleLabel, 'Georgian') >= 0 ? 'Georgian' : indexof(datum.styleLabel, 'Victorian') >= 0 ? 'Victorian' : indexof(datum.styleLabel, 'Federation') >= 0 ? 'Federation' : indexof(datum.styleLabel, 'Classical') >= 0 || indexof(datum.styleLabel, 'Doric') >= 0 ? 'Classical' : 'Other'",
      "as": "Broad_Style"
    },
    {"filter": "datum.year >= 1800 && datum.year <= 2000"}
  ],
  "params": [
    {
      "name": "slice_select",
      "select": {"type": "point", "fields": ["Broad_Style"]}
    }
  ],
  "mark": {
    "type": "arc", 
    "innerRadius": 70, 
    "stroke": "#F8F7F4", 
    "strokeWidth": 2,
    "cursor": "pointer"
  },
  "encoding": {
    "theta": {"aggregate": "count", "type": "quantitative"},
    "color": {
      "field": "Broad_Style",
      "type": "nominal",
      "title": "Architectural Era",
      "scale": {
        "range": ["#56B4E9", "#E69F00", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7"]
      }
    },
    "opacity": {
      "condition": {"param": "slice_select", "value": 1},
      "value": 0.2
    },
    "tooltip": [
      {"field": "Broad_Style", "type": "nominal", "title": "Style Era"},
      {"aggregate": "count", "type": "quantitative", "title": "Total Buildings"}
    ]
  },
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"}
  }
}