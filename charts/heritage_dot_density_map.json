{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "height": 600,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0]
  },
  "params": [
    {
      "name": "Style_Dropdown",
      "bind": {
        "input": "select",
        "options": [null, "Gothic", "Art Deco", "Georgian", "Victorian", "Classical", "Other"],
        "labels": ["Show All", "Gothic", "Art Deco", "Georgian", "Victorian", "Classical", "Other"],
        "name": "Select Architectural Era: "
      }
    },
    {
      "name": "Year_Slider",
      "value": 1800,
      "bind": {
        "input": "range",
        "min": 1800,
        "max": 2000,
        "step": 10,
        "name": "Minimum Year Built: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "charts/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F0F0",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/wikidata_heritage_styles.csv"
      },
      "mark": {
        "type": "circle",
        "size": 50,
        "opacity": 0.8,
        "strokeWidth": 0
      },
      "transform": [
        {
          "calculate": "indexof(datum.styleLabel, 'Gothic') >= 0 ? 'Gothic' : indexof(datum.styleLabel, 'Art Deco') >= 0 ? 'Art Deco' : indexof(datum.styleLabel, 'Georgian') >= 0 ? 'Georgian' : indexof(datum.styleLabel, 'Victorian') >= 0 ? 'Victorian' : indexof(datum.styleLabel, 'Classical') >= 0 || indexof(datum.styleLabel, 'Doric') >= 0 ? 'Classical' : 'Other'",
          "as": "Broad_Style"
        },
        {"filter": "Style_Dropdown == null || datum.Broad_Style == Style_Dropdown"},
        {"filter": "datum.year >= Year_Slider"}
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "Broad_Style",
          "type": "nominal",
          "title": null,
          "scale": {
            "range": ["#56B4E9", "#E69F00", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7"]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "buildingLabel", "type": "nominal", "title": "Building Name"},
          {"field": "styleLabel", "type": "nominal", "title": "Style"},
          {"field": "year", "type": "quantitative", "title": "Year Built"}
        ]
      }
    },
    {
      "data": {"values": [{}]},
      "transform": [
        {"calculate": "Year_Slider", "as": "year_label"}
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 63,
        "fontWeight": "bold",
        "color": "#C28E5C",
        "opacity": 0.4
      },
      "encoding": {
        "x": {"value": 950}, 
        "y": {"value": 20},
        "text": {"field": "year_label"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    }
  }
}