{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "height": 400,
  "data": {"url": "data/cleaned_abs_houses.csv"},
  "transform": [
    {"filter": "datum.State == 'New South Wales' || datum.State == 'Victoria'"}
  ],
  "layer": [
    {
      "params": [
        {
          "name": "brush",
          "select": {"type": "interval", "encodings": ["x"]}
        }
      ],
      "mark": {"type": "line", "strokeWidth": 2, "opacity": 0.2},
      "encoding": {
        "x": {
          "field": "Date", "type": "temporal", "title": "Year", "axis": {"grid": false}
        },
        "y": {
          "field": "Count", "type": "quantitative", "title": "Monthly House Approvals", "axis": {"grid": true}
        },
        "color": {
          "field": "State", "type": "nominal", "title": "State",
          "scale": {"domain": ["New South Wales", "Victoria"], "range": ["#1A2C38", "#C28E5C"]}
        }
      }
    },
    {
      "transform": [{"filter": {"param": "brush"}}],
      "mark": {"type": "line", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "Date", "type": "temporal"},
        "y": {"field": "Count", "type": "quantitative"},
        "color": {"field": "State", "type": "nominal"},
        "tooltip": [
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Date", "type": "temporal", "format": "%b %Y", "title": "Month"},
          {"field": "Count", "type": "quantitative", "title": "Houses Approved", "format": ","}
        ]
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "rule", "color": "#777777", "strokeDash": [4, 4]},
      "encoding": {
        "x": {"datum": {"year": 2002}}
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {
        "type": "text", "align": "left", "dx": 5, "dy": 0, 
        "font": "Inter", "fontSize": 12, "fontWeight": 400, "color": "#555555"
      },
      "encoding": {
        "x": {"datum": {"year": 2002}},
        "y": {"datum": 4800},
        "text": {"value": "2002: Victoria permanently pulls ahead"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"}
  }
}