{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
  "type": "fit",
  "contains": "padding"
},
  "height": 400,
  "data": {
    "url": "wikidata_heritage_styles.csv"
  },
  "transform": [
    {
      "calculate": "indexof(datum.styleLabel, 'Gothic') >= 0 ? 'Gothic' : indexof(datum.styleLabel, 'Art Deco') >= 0 ? 'Art Deco' : indexof(datum.styleLabel, 'Georgian') >= 0 ? 'Georgian' : indexof(datum.styleLabel, 'Victorian') >= 0 ? 'Victorian' : indexof(datum.styleLabel, 'Classical') >= 0 || indexof(datum.styleLabel, 'Doric') >= 0 ? 'Classical' : 'Other'",
      "as": "Broad_Style"
    },
    {
      "filter": "datum.year >= 1800 && datum.year <= 2000"
    },
    {
      "bin": {"step": 10},
      "field": "year",
      "as": "Decade"
    }
  ],
"params": [
    {
      "name": "style_highlight",
      "select": {"type": "point", "on": "mouseover", "fields": ["Broad_Style"]}
    }
  ],

  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "opacity": {
      "condition": {"param": "style_highlight", "value": 1},
      "value": 0.2
    },
    "x": {
      "field": "Decade",
      "type": "quantitative",
      "title": "Decade Built",
      "axis": {
        "format": "d",
        "tickCount": 10,
        "grid": false
      },
      "scale": {"zero": false}
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "stack": "zero",
      "axis": {"title": "Number of Events"}
    },
    "color": {
      "field": "Broad_Style",
      "type": "nominal",
      "title": "Architectural Era"
    },
    "tooltip": [
      {"field": "Broad_Style", "type": "nominal", "title": "Style Era"},
      {"field": "Decade", "type": "quantitative", "title": "Decade"},
      {"aggregate": "count", "type": "quantitative", "title": "Buildings Constructed"}
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    }
  }
}