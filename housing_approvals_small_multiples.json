{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "cleaned_abs_houses.csv"},
  
  "width": 220,
  "height": 150,

  "mark": {
    "type": "area",
    "line": {"color": "#1A2C38"},
    "color": {
      "x1": 1, "y1": 1,
      "x2": 1, "y2": 0,
      "gradient": "linear",
      "stops": [
        {"offset": 0, "color": "white"},
        {"offset": 1, "color": "#1A2C38"}
      ]
    }
  },
  "encoding": {
    "facet": {
      "field": "State",
      "type": "nominal",
      "columns": 4,
      "title": null,
      "header": {"labelFontSize": 13, "labelFontWeight": "bold"}
    },
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": "Year",
      "axis": {
        "grid": false, 
        "labelFontSize": 12, 
        "titleFontSize": 12
      }
    },
    "y": {
      "field": "Count",
      "type": "quantitative",
      "title": "Number of Houses",
      "axis": {
        "grid": true, 
        "labelFontSize": 12, 
        "titleFontSize": 12,
        "tickCount": 4
      }
    },
    "tooltip": [
      {"field": "Date", "type": "temporal", "format": "%b %Y", "title": "Month"},
      {"field": "Count", "type": "quantitative", "title": "Houses Approved", "format": ","}
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    }
  }
}