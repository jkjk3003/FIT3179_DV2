{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "cleaned_abs_houses.csv"},
  
  "width": 380,
  "height": 220,

  "mark": {
    "type": "area",
    "line": {"color": "#1f77b4"},
    "color": {
      "x1": 1, "y1": 1,
      "x2": 1, "y2": 0,
      "gradient": "linear",
      "stops": [
        {"offset": 0, "color": "white"},
        {"offset": 1, "color": "#1f77b4"}
      ]
    }
  },
  "encoding": {
    "facet": {
      "field": "State",
      "type": "nominal",
      "columns": 2,
      "title": null,
      "header": {"labelFontSize": 12, "labelFontWeight": "bold"}
    },
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": "Year",
      "axis": {"grid": false}
    },
    "y": {
      "field": "Count",
      "type": "quantitative",
      "title": "Number of Houses",
      "axis": {"grid": true}
    },
    "tooltip": [
      {"field": "Date", "type": "temporal", "format": "%b %Y", "title": "Month"},
      {"field": "Count", "type": "quantitative", "title": "Houses Approved", "format": ","}
    ]
  },
  "resolve": {
    "scale": {"y": "independent"}
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    }
  }
}